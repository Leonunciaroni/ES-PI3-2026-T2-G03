# Copie para .env (NÃO commite o .env) e preencha.
# O Firebase CLI envia essas variáveis no deploy (Cloud Functions v2).
#
# Gmail: ative verificação em 2 etapas e crie “Senha de app”:
# https://myaccount.google.com/apppasswords
#
# Depois: cd functions && npm run build && firebase deploy --only functions

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
SMTP_FROM=seuemail@gmail.com
