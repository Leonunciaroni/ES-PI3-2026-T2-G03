# Configuração SMTP para envio do código 2FA por e-mail.
# Copie este arquivo para .env e preencha com seus dados.
# Para Gmail: habilite "Senhas de app" no Google Account
# (https://myaccount.google.com/apppasswords) e use a senha gerada.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=senha_de_app_gerada
SMTP_FROM=seuemail@gmail.com
